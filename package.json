{
  "name": "@teages/nitro-drizzle",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "description": "Drizzle ORM integration for Nitro v3",
  "license": "MIT",
  "repository": "Teages/nitro-drizzle",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
      "import": "./dist/nuxt.mjs",
      "default": "./dist/nuxt.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs",
      "default": "./dist/types.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "./nuxt": [
        "./dist/nuxt.d.mts"
      ],
      "./config": [
        "./dist/config.d.mts"
      ],
      "./types": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "pnpm -F './playgrounds/*' prepare",
    "dev": "pnpm -C playgrounds/nitro dev",
    "dev:nuxt": "pnpm -C playgrounds/nuxt dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepack": "pnpm build",
    "test": "pnpm lint && pnpm typecheck && vitest run --coverage --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "pnpm tsc --build --noEmit",
    "test:bun": "bun test test/runtime/studio/adapters.bun.test.ts"
  },
  "peerDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "nitro": ">=3.0.260610-beta <4",
    "nuxt": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "npm:@nuxt/kit-nightly@5.0.0-29801588.e458891d",
    "get-port-please": "^3.2.0",
    "srvx": "^0.11.16"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@libsql/client": "^0.17.4",
    "@nuxt/nitro-server": "npm:@nuxt/nitro-server-nightly@5.0.0-29801588.e458891d",
    "@nuxt/schema": "npm:@nuxt/schema-nightly@5.0.0-29801588.e458891d",
    "@tsconfig/node24": "^24.0.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.12.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "mysql2": "^3.23.3",
    "nitro": "^3.0.260610-beta",
    "nuxt": "npm:nuxt-nightly@5.0.0-29801588.e458891d",
    "obuild": "^0.4.38",
    "pkg-pr-new": "^0.0.88",
    "postgres": "^3.4.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
