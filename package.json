{
  "name": "@teages/nitro-drizzle",
  "type": "module",
  "version": "0.4.5",
  "packageManager": "pnpm@11.22.0",
  "description": "Drizzle ORM integration for Nitro v3",
  "license": "MIT",
  "repository": "Teages/nitro-drizzle",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./devtool": "./src/devtool.ts",
    "./nuxt": "./src/nuxt.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json",
    "./runtime/*": "./src/runtime/*.ts"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "./nuxt": [
        "./dist/nuxt.d.mts"
      ],
      "./config": [
        "./dist/config.d.mts"
      ],
      "./types": [
        "./dist/types.d.mts"
      ],
      "./devtool": [
        "./dist/devtool.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "dev:prepare": "pnpm -F './playgrounds/*' prepare",
    "dev": "pnpm -C playgrounds/nitro dev",
    "dev:nuxt": "pnpm -C playgrounds/nuxt dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepack": "pnpm build",
    "test": "pnpm lint && pnpm typecheck && vitest run --coverage --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "pnpm tsc --build --noEmit",
    "test:bun": "bun test test/runtime/studio/adapters.bun.test.ts"
  },
  "peerDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "nitro": ">=3.0.261103-rc <4",
    "nuxt": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "npm:@nuxt/kit-nightly@5.0.0-2611092254-8b7f263"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@libsql/client": "^0.18.0",
    "@nuxt/nitro-server": "npm:@nuxt/nitro-server-nightly@5.0.0-2611092254-8b7f263",
    "@nuxt/schema": "npm:@nuxt/schema-nightly@5.0.0-2611092254-8b7f263",
    "@tsconfig/node26": "^26.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/devtools-kit": "^0.8.2",
    "@vitest/coverage-v8": "^4.1.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "eslint": "^10.14.0",
    "mysql2": "^3.24.6",
    "nitro": "^3.0.261103-rc",
    "nuxt": "npm:nuxt-nightly@5.0.0-2611092254-8b7f263",
    "pkg-pr-new": "^0.0.93",
    "postgres": "^3.4.9",
    "publint": "^0.3.25",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": "./dist/index.mjs",
      "./config": "./dist/config.mjs",
      "./devtool": "./dist/devtool.mjs",
      "./nuxt": "./dist/nuxt.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json",
      "./runtime/*": "./dist/runtime/*.mjs"
    }
  }
}
